; Engine configuration file.
; Canion Raid VR - szkielet projektu pod Meta Quest.
;
; Jeśli Godot zaproponuje konwersję przy pierwszym otwarciu, zgódź się:
; plik jest pisany pod Godota 4.4+, nowsze wersje tylko dopiszą swoje pola.

config_version=5

[application]

config/name="Canion Raid VR"
config/description="Kaskaderska jazda VR niekończącym się wąwozem."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[physics]

; Sztywne zawieszenia i lądowania z dużej wysokości rozsypują się przy 60 Hz.
; 120 Hz (było 240): na Queście fizyka aut zjadała cały budżet klatki;
; testy jazdy, ABS/ESP, odradzania i wgnieceń dają przy 120 Hz to samo
; (opony mają 6 podkroków zamiast 4, podłoże badane promieniem).
common/physics_ticks_per_second=120
common/physics_interpolation=true

[rendering]

; Renderer mobilny - wymagany na Queście.
renderer/rendering_method="mobile"
; 2x MSAA (było 4x): przy 130% rozdzielczości w goglach różnica mała,
; a GPU Questa było wąskim gardłem.
anti_aliasing/quality/msaa_3d=1
; Quest (Android) wymaga tekstur ETC2/ASTC.
textures/vram_compression/import_etc2_astc=true
; Filtrowanie anizotropowe 4x: jezdnia i ściany pod kątem ostrzejsze
; (16x razem ze 160% rozdzielczości dawało na Queście ~8 kl./s).
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0

[xr]

openxr/enabled=true
; Bez gogli (np. na PC bez runtime'u OpenXR) gra po cichu przechodzi
; w tryb płaski, zamiast pokazywać okno z ostrzeżeniem przy każdym starcie.
openxr/startup_alert=false
; Przestrzeń "local": punkt odniesienia przy głowie, nie na podłodze -
; właściwa dla gry na siedząco w kokpicie (center_on_hmd ustawia go od nowa).
openxr/reference_space=0
; Foweacja (brzegi obrazu rzadziej), dynamiczna - poziom z menu, patrz
; GameSettings.apply_xr_quality.
openxr/foveation_level=2
openxr/foveation_dynamic=true
shaders/enabled=true
